{
  "title": "Issue Tracker — Service & Discord Bot",
  "description": "",
  "tags": ["issue-tracker", "otel"],
  "editable": true,
  "cursorSync": "Crosshair",
  "liveNow": false,
  "preload": false,
  "links": [],
  "annotations": [
    {
      "kind": "AnnotationQuery",
      "spec": {
        "name": "Annotations & Alerts",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "builtIn": true,
        "query": {
          "kind": "DataQuery",
          "group": "grafana",
          "version": "v0",
          "spec": {}
        }
      }
    }
  ],
  "variables": [],
  "timeSettings": {
    "from": "now-1h",
    "to": "now",
    "timezone": "browser",
    "autoRefresh": "",
    "autoRefreshIntervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"],
    "hideTimepicker": false,
    "fiscalYearStartMonth": 0
  },
  "elements": {
    "request-latency": {
      "kind": "Panel",
      "spec": {
        "id": 1,
        "title": "Request Latency (p50 / p95 / p99)",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "spec": {
                      "expr": "histogram_quantile(0.5, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"issue-tracker-service\"}[5m])) by (le))",
                      "legendFormat": "p50"
                    }
                  }
                }
              },
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "B",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "spec": {
                      "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"issue-tracker-service\"}[5m])) by (le))",
                      "legendFormat": "p95"
                    }
                  }
                }
              },
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "C",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "spec": {
                      "expr": "histogram_quantile(0.99, sum(rate(http_server_request_duration_seconds_bucket{service_name=\"issue-tracker-service\"}[5m])) by (le))",
                      "legendFormat": "p99"
                    }
                  }
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "version": "v0",
          "spec": {
            "options": {
              "legend": { "displayMode": "list", "placement": "bottom" },
              "tooltip": { "mode": "multi" }
            },
            "fieldConfig": {
              "defaults": {
                "unit": "s",
                "custom": {
                  "drawStyle": "line",
                  "lineInterpolation": "smooth",
                  "fillOpacity": 10,
                  "pointSize": 5,
                  "showPoints": "auto"
                }
              },
              "overrides": []
            }
          }
        }
      }
    },
    "success-rate": {
      "kind": "Panel",
      "spec": {
        "id": 2,
        "title": "Success Rate (2xx)",
        "description": "",
        "links": [],
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "refId": "A",
                  "hidden": false,
                  "query": {
                    "kind": "DataQuery",
                    "group": "prometheus",
                    "version": "v0",
                    "spec": {
                      "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"issue-tracker-service\", http_response_status_code=~\"2..\"}[5m])) / sum(rate(http_server_request_duration_seconds_count{service_name=\"issue-tracker-service\"}[5m])) * 100",
                      "legendFormat": "Success %"
                    }
                  }
                }
              }
            ],
            "transformations": [],
            "queryOptions": {}
          }
        },
        "vizConfig": {
          "kind": "VizConfig",
          "group": "timeseries",
          "version": "v0",
          "spec": {
            "options": {
              "legend": { "displayMode": "list", "placement": "bottom" },
              "tooltip": { "mode": "multi" }
            },
            "fieldConfig": {
              "defaults": {
                "unit": "percent",
                "min": 0,
                "max": 100,
                "custom": {
                  "drawStyle": "line",
                  "lineInterpolation": "smooth",
                  "fillOpacity": 20,
                  "pointSize": 5,
                  "showPoints": "auto"
                },
                "color": { "mode": "fixed", "fixedColor": "green" }
              },
              "overrides": []
            }
          }
        }
      }
    },
